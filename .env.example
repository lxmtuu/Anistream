# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠️ service_role key (KHÔNG phải anon key) — chỉ dùng trong worker/cron, không bao giờ nhúng vào app
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# TMDB (miễn phí) — dùng cho job D: tên + tóm tắt TIẾNG VIỆT và danh sách tập.
# Không có key: app vẫn chạy nhưng tên là romaji/english và phần lớn bộ không có tập.
# Lấy key: themoviedb.org → Settings → API → "API Key (v3)"  (KHÔNG dùng v4 token)
TMDB_API_KEY=

# 1 = không ghi DB
DRY_RUN=0

# YouTube Data API v3 (free 10k quota/day) — bật "deep backfill": lấy TOÀN BỘ
# lịch sử video của kênh thay vì chỉ 15 video mới nhất từ RSS.
# Tạo: console.cloud.google.com → enable "YouTube Data API v3" → Create credentials → API key
YOUTUBE_API_KEY=
