# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠️ service_role key (KHÔNG phải anon key) — chỉ dùng trong worker/cron, không bao giờ nhúng vào app
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ⚠️ TMDB: ingest HIỆN CHƯA dùng biến này (chưa có bước dịch nào trong code).
#    Đặt key vào cũng không làm title_vi/synopsis_vi xuất hiện → để trống.
#    Tóm tắt hiện lấy từ AniList (cột anime.synopsis_original), không cần key.
TMDB_API_KEY=

# 1 = không ghi DB
DRY_RUN=0

# YouTube Data API v3 (free 10k quota/day) — bật "deep backfill": lấy TOÀN BỘ
# lịch sử video của kênh thay vì chỉ 15 video mới nhất từ RSS.
# Tạo: console.cloud.google.com → enable "YouTube Data API v3" → Create credentials → API key
YOUTUBE_API_KEY=
